{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/vision/",
        "http://127.0.0.1:4173/services/",
        "http://127.0.0.1:4173/products/",
        "http://127.0.0.1:4173/roadmap/",
        "http://127.0.0.1:4173/about/",
        "http://127.0.0.1:4173/contact/",
        "http://127.0.0.1:4173/privacy/",
        "http://127.0.0.1:4173/terms/"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "npm run preview",
      "startServerReadyPattern": "Preview server listening",
      "startServerUrl": "http://127.0.0.1:4173",
      "settings": {
        "formFactor": "mobile"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
