{
  "name": "sgs-ai-technology-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:js": "eslint public src test scripts",
    "lint:css": "stylelint \"public/**/*.css\"",
    "validate:html": "html-validate \"public/**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "check:dist": "node scripts/check-links.mjs dist",
    "test": "node --test",
    "lint": "npm run lint:js && npm run lint:css && npm run validate:html && npm run check:links",
    "build": "node scripts/build.mjs",
    "start": "node src/server/server.mjs",
    "preview": "node scripts/preview.mjs",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "google-auth-library": "^11.3.0",
    "nodemailer": "6.10.1"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "clean-css": "5.3.3",
    "eslint": "9.28.0",
    "globals": "16.2.0",
    "html-minifier-terser": "7.2.0",
    "html-validate": "11.17.0",
    "stylelint": "16.21.1",
    "stylelint-config-recommended": "16.0.0",
    "terser": "5.43.1"
  }
}
